# Life Guardian AI — local/server environment
# Copy to .env.local and fill in values. Never commit real secrets.

# -----------------------------------------------------------------------------
# Gemini API credentials (Google AI Studio)
# One key, or several separated by commas. With several, a key that is out of
# quota or revoked hands over to the next one automatically.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEYS=

# -----------------------------------------------------------------------------
# Model configuration
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# Generation parameters
# Keep temperature low: the extraction layer must not invent facts or numbers.
# -----------------------------------------------------------------------------
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40
GEMINI_MAX_OUTPUT_TOKENS=2048

# -----------------------------------------------------------------------------
# Backend AI client
# GEMINI_API_KEY alone is enough — the client then targets Gemini's
# OpenAI-compatible endpoint automatically. Set these only to override,
# for example to point at Netlify AI Gateway or another provider.
# -----------------------------------------------------------------------------
AI_API_KEY=
# Comma-separated pool, tried in order. Takes precedence over AI_API_KEY.
AI_API_KEYS=
AI_MODEL=
AI_BASE_URL=

# Labeled deterministic fallback. Responses include "source": "demo_backup".
DEMO_BACKUP_MODE=false

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
# LIFE GUARDIAN AI v2 — full conversational pipeline
N8N_LIFE_GUARDIAN_WEBHOOK_URL=
# Follow-up scheduling webhook
N8N_WEBHOOK_URL=

# Chat message archive (n8n workflow -> MongoDB Atlas). Optional: the app runs without it.
N8N_CHAT_LOG_WEBHOOK_URL=

# Direct MongoDB Atlas write. When set, this is used instead of the n8n chat-log webhook.
MONGODB_URI=
MONGODB_DB=lifeguardian
