# Life Guardian AI — local/server environment
# Copy to .env.local and fill in values. Never commit real secrets.

# Required for live analysis (OpenAI-compatible).
# On Netlify, you may instead enable AI Gateway after the first production deploy.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Optional labeled demo fallback. Responses include "source": "demo_backup".
DEMO_BACKUP_MODE=false

# n8n follow-up webhook
N8N_WEBHOOK_URL=
